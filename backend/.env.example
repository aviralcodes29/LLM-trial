# ==============================================================================
# DocChat AI — Environment Configuration (.env.example)
# ==============================================================================

# Application environment and debugging
APP_NAME=DocChat AI
ENVIRONMENT=development
DEBUG_MODE=false

# Google Gemini API key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# Local storage paths
CHROMA_PATH=./chroma_db
DATABASE_URL=sqlite:///./docchat.db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_AUTH=false

# Rate Limiting (Slowapi)
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=10/hour

# RAG & Vector Search Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=3
RELEVANCE_THRESHOLD=0.30

# Usage Cost Estimates (USD per 1M tokens)
INPUT_COST_PER_MILLION_TOKENS=0.075
OUTPUT_COST_PER_MILLION_TOKENS=0.30
